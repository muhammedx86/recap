{
  "id": "marvel-rivals",
  "name": "Marvel Rivals",
  "processes": [
    "Marvel-Win64-Shipping.exe"
  ],
  "capture": "game",
  "api": "marvel-state-file",
  "preferApi": true,
  "autoClip": {
    "events": [
      "kill"
    ]
  },
  "postMatch": [],
  "color": "#F2C230",
  "exclusions": [
    {
      "drop": "kill",
      "near": "death",
      "beforeMs": 1500,
      "afterMs": 15000
    }
  ],
  "moments": {
    "liveClips": false,
    "events": [
      {
        "id": "kill",
        "label": "Kill",
        "clip": false
      },
      {
        "id": "death",
        "label": "Death",
        "clip": false
      },
      {
        "id": "round_win",
        "label": "Round won",
        "clip": false
      },
      {
        "id": "round_loss",
        "label": "Round lost",
        "clip": false
      },
      {
        "id": "match_end",
        "label": "Match end",
        "clip": false
      }
    ]
  }
}
