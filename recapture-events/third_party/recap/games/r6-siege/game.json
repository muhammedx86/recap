{
  "id": "r6-siege",
  "name": "Rainbow Six Siege",
  "processes": [
    "RainbowSix.exe",
    "RainbowSix_Vulkan.exe",
    "RainbowSix_DX11.exe"
  ],
  "capture": "game",
  "preferApi": true,
  "autoClip": {
    "events": [
      "kill"
    ]
  },
  "postMatch": [],
  "color": "#C9A227",
  "moments": {
    "liveClips": false,
    "events": [
      {
        "id": "kill",
        "label": "Kill",
        "clip": false
      },
      {
        "id": "death",
        "label": "Death",
        "clip": false
      },
      {
        "id": "round_win",
        "label": "Round won",
        "clip": false
      },
      {
        "id": "round_loss",
        "label": "Round lost",
        "clip": false
      },
      {
        "id": "round_start",
        "label": "Round start",
        "clip": false
      },
      {
        "id": "match_end",
        "label": "Match end",
        "clip": false
      }
    ]
  }
}
