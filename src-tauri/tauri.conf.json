{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Recap",
  "version": "0.1.0",
  "identifier": "com.recap.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Recap",
        "width": 1360,
        "height": 860,
        "minWidth": 1100,
        "minHeight": 680,
        "center": true,
        "visible": false,
        "backgroundColor": "#0b0b0c"
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data: blob:; media-src 'self' asset: http://asset.localhost blob:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Recap contributors",
    "copyright": "GPL-3.0-or-later",
    "category": "Video",
    "shortDescription": "Local game recorder with event detection",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "obs": "obs",
      "binaries": "binaries",
      "../games": "games"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
